# Скопируйте в .env и задайте свой пароль PostgreSQL.
# Используйте буквы и цифры без @ : / ? # — иначе потребуется URL-кодирование.
POSTGRES_DB=osv
POSTGRES_USER=osv
POSTGRES_PASSWORD=change_me

# Порт сайта на хосте сервера (прямые обращения только с самого сервера;
# снаружи сайт доступен через nginx по 443)
APP_PORT=8010

# Порты nginx: 80 только редиректит на 443
HTTP_PORT=80
HTTPS_PORT=443

# Имя в самоподписанном сертификате (используется, если в deploy/certs/
# нет корпоративных fullchain.pem / privkey.pem)
TLS_CN=bdr.alabuga.ru

# Максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=25
